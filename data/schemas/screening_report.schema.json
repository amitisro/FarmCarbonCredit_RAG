{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/screening_report.schema.json",
  "title": "Farm boundary screening report",
  "type": "object",
  "required": [
    "field",
    "analysis",
    "limitations"
  ],
  "properties": {
    "field": {
      "type": "object",
      "required": [
        "field_id",
        "source_file",
        "area_ha",
        "geometry_wgs84"
      ],
      "properties": {
        "field_id": {
          "type": "string",
          "minLength": 1
        },
        "source_file": {
          "type": "string"
        },
        "area_ha": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "geometry_wgs84": {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "enum": [
                "Polygon",
                "MultiPolygon"
              ]
            },
            "coordinates": {
              "type": "array",
              "minItems": 1
            }
          }
        }
      }
    },
    "analysis": {
      "type": "object",
      "required": [
        "provider",
        "collection",
        "screening_model",
        "years",
        "comparison",
        "crop_classification",
        "carbon_credit"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "collection": {
          "const": "sentinel-2-l2a"
        },
        "screening_model": {
          "type": "object",
          "required": [
            "model_id",
            "version",
            "method",
            "dnbr_threshold"
          ],
          "properties": {
            "model_id": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "method": {
              "type": "string"
            },
            "dnbr_threshold": {
              "type": "number"
            },
            "cloud_cover_limit_percent": {
              "type": "number"
            },
            "max_scenes_per_window": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": true
        },
        "years": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "year",
              "status",
              "dnbr",
              "reason"
            ],
            "properties": {
              "year": {
                "type": "integer"
              },
              "status": {
                "enum": [
                  "possible_burn_scar_signal",
                  "burn_scar_not_detected",
                  "indeterminate"
                ]
              },
              "dnbr": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "reason": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "comparison": {
          "type": "object",
          "required": [
            "possible_burn_scar_signal_years",
            "not_detected_years",
            "indeterminate_years",
            "trend",
            "interpretation"
          ],
          "properties": {
            "possible_burn_scar_signal_years": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "not_detected_years": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "indeterminate_years": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "trend": {
              "type": "string"
            },
            "interpretation": {
              "type": "string"
            }
          }
        },
        "crop_classification": {
          "type": "object",
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "not_assessed"
            },
            "reason": {
              "type": "string"
            }
          }
        },
        "carbon_credit": {
          "type": "object",
          "required": [
            "eligible",
            "estimated_emissions_avoided_tco2e",
            "reason"
          ],
          "properties": {
            "eligible": {
              "type": "null"
            },
            "estimated_emissions_avoided_tco2e": {
              "type": "null"
            },
            "reason": {
              "type": "string"
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
