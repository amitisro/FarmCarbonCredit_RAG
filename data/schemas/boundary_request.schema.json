{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/boundary_request.schema.json",
  "title": "Farm boundary request",
  "description": "Accepted geometry is normalized to WGS84 before analysis. CSV bbox coordinate order is min_lon,min_lat,max_lon,max_lat (or a documented supported alias).",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "type",
        "geometry"
      ],
      "properties": {
        "type": {
          "const": "Feature"
        },
        "id": {
          "type": [
            "string",
            "number"
          ]
        },
        "properties": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "field_id": {
              "type": [
                "string",
                "number"
              ]
            }
          },
          "additionalProperties": true
        },
        "geometry": {
          "$ref": "#/$defs/polygonGeometry"
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": [
        "type",
        "features"
      ],
      "properties": {
        "type": {
          "const": "FeatureCollection"
        },
        "features": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/oneOf/0"
          }
        }
      },
      "additionalProperties": true
    },
    {
      "$ref": "#/$defs/polygonGeometry"
    }
  ],
  "$defs": {
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "ring": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/position"
      }
    },
    "polygonGeometry": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "enum": [
            "Polygon",
            "MultiPolygon"
          ]
        },
        "coordinates": {
          "type": "array",
          "minItems": 1
        }
      },
      "additionalProperties": true
    }
  }
}
